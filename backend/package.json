{
  "name": "tablestakes",
  "version": "1.0.0",
  "description": "Serverless example using Typescript",
  "main": "handler.js",
  "scripts": {
    "test": "jest",
    "offline": "sls offline",
    "encryptSecret": "ts-node src/scripts/encryptSecret.ts",
    "decryptSecret": "ts-node src/scripts/decryptSecret.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^6.1.1",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^4.1.12",
    "aws-serverless-express": "^3.3.6",
    "express": "^4.17.1",
    "nodemailer": "^6.4.2",
    "passport": "^0.4.1",
    "passport-jwt": "^4.0.0",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^6.5.4",
    "source-map-support": "^0.5.10",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.39",
    "@types/aws-serverless-express": "^3.3.2",
    "@types/express": "^4.17.2",
    "@types/jest": "^29.0.0",
    "@types/node": "^10.12.18",
    "@types/nodemailer": "^6.4.0",
    "@types/passport-jwt": "^3.0.3",
    "@types/passport-local": "^1.0.33",
    "@types/source-map-support": "^0.5.0",
    "@types/supertest": "^2.0.8",
    "aws-sdk": "^2.606.0",
    "db-migrate": "^0.11.6",
    "db-migrate-mysql": "^2.1.0",
    "jest": "^29.0.0",
    "serverless": "^1.60.5",
    "serverless-offline": "^5.12.1",
    "serverless-plugin-optimize": "^4.1.3-rc.1",
    "serverless-plugin-typescript": "^1.1.9",
    "supertest": "^4.0.2",
    "ts-jest": "^29.0.0",
    "ts-loader": "^9.0.0",
    "ts-node": "^10.0.0",
    "typemoq": "^2.1.0",
    "typescript": "^5.0.0"
  },
  "author": "The serverless webpack authors (https://github.com/elastic-coders/serverless-webpack)",
  "license": "MIT",
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".test.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverage": false,
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/node_modules/**",
      "!**/scratch/**"
    ],
    "coverageDirectory": ".coverage/",
    "testEnvironment": "node"
  },
  "coverageReporters": [
    "html"
  ]
}
